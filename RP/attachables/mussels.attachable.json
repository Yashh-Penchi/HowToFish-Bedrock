{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "yashh:mussels",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/mussels",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.yashh_mussels_item"
      },
      "animations": {
        "hold_first_person": "animation.yashh_mussels.hold_first_person",
        "hold_third_person": "animation.yashh_mussels.hold_third_person",
        "eat_first_person": "animation.yashh_mussels.eat_first_person",
        "eat_ctrl": "controller.animation.yashh_mussels.eat"
      },
      "scripts": {
        "pre_animation": [
          "v.using = q.is_using_item || c.owning_entity->q.is_using_item;"
        ],
        "animate": [
          {
            "hold_first_person": "c.is_first_person && !v.using"
          },
          {
            "hold_third_person": "!c.is_first_person"
          },
          "eat_ctrl"
        ]
      },
      "render_controllers": [
        "controller.render.yashh_item"
      ]
    }
  }
}